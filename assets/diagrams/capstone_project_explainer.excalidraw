      "link": null,
      "locked": false,
      "customData": null,
      "text": "CORE \u2014 COMMITTED\n\nLaptop-first CPU + simulator\nSmall static graph / ONNX subset\nMeasured oracle + regret\nC++ runtime + structured traces",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CORE \u2014 COMMITTED\n\nLaptop-first CPU + simulator\nSmall static graph / ONNX subset\nMeasured oracle + regret\nC++ runtime + structured traces",
      "autoResize": true,
      "lineHeight": 1.25
    },
